{
  "manifest_version": 3,
  "name": "英语阅读助手",
  "version": "0.0.1",
  "author": "Albert Huang",
  "permissions": [
    "storage",
    "tabs",
    "declarativeContent"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon-gray.png",
      "32": "assets/icon-gray.png",
      "48": "assets/icon-gray.png",
      "64": "assets/icon-gray.png",
      "128": "assets/icon-gray.png"
    },
    "default_popup": "src/popup.html"
  },
  "icons": {
    "16": "assets/icon.png",
    "32": "assets/icon.png",
    "48": "assets/icon.png",
    "64": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.newsinlevels.com/*"
      ],
      "js": [
        "src/NewsInLevles.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://breakingnewsenglish.com/graded-news-stories.html"
      ],
      "js": [
        "src/BreakingNewsEnglish.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/readed.svg",
        "assets/unread.svg"
      ],
      "matches": [
        "https://www.newsinlevels.com/*"
      ]
    },
    {
      "resources": [
        "assets/readed.svg",
        "assets/unread.svg"
      ],
      "matches": [
        "https://breakingnewsenglish.com/*"
      ]
    }
  ]
}